<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.ActivityFavoriteMapper">

    <resultMap id="ActivityFavoriteResultMap" type="com.campus.activity.entity.ActivityFavorite">
        <id property="id" column="id"/>
        <result property="activityId" column="activity_id"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, activity_id, user_id, created_at
    </sql>

    <!--
      Fast existence check for "favorite" button state.
      Unique index uk_activity_favorites_activity_user avoids duplicate rows.
    -->
    <select id="existsFavorite" resultType="java.lang.Boolean">
        SELECT CASE WHEN COUNT(1) > 0 THEN TRUE ELSE FALSE END
        FROM activity_favorites
        WHERE activity_id = #{activityId}
          AND user_id = #{userId}
    </select>
</mapper>
