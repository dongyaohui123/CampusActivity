<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.OrganizerFollowMapper">

    <resultMap id="OrganizerFollowResultMap" type="com.campus.activity.entity.OrganizerFollow">
        <id property="id" column="id"/>
        <result property="organizerId" column="organizer_id"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, organizer_id, user_id, created_at
    </sql>

    <!--
      Fast existence check for "follow organizer" state.
      Unique index uk_organizer_follows_organizer_user supports this query.
    -->
    <select id="existsFollow" resultType="java.lang.Boolean">
        SELECT CASE WHEN COUNT(1) > 0 THEN TRUE ELSE FALSE END
        FROM organizer_follows
        WHERE organizer_id = #{organizerId}
          AND user_id = #{userId}
    </select>
</mapper>
