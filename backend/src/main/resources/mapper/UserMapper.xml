<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.UserMapper">

    <!--
      users result mapping.
      BaseMapper already provides generic CRUD. This resultMap guarantees that
      enum/string/boolean fields map predictably when used in custom SQL.
    -->
    <resultMap id="UserResultMap" type="com.campus.activity.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="openid" column="openid"/>
        <result property="nickname" column="nickname"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="gender" column="gender"/>
        <result property="phone" column="phone"/>
        <result property="role" column="role" javaType="com.campus.activity.enums.UserRole"/>
        <result property="status" column="status" javaType="com.campus.activity.enums.UserStatus"/>
        <result property="forcePasswordChange" column="force_password_change"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password_hash, openid, nickname, avatar_url, gender, phone,
        role, status, force_password_change, last_login_at, created_at, updated_at
    </sql>

    <!-- Unique-key query. Index uk_users_username is expected to be used. -->
    <select id="selectByUsername" resultMap="UserResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM users
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- Unique-key query. Index uk_users_openid is expected to be used. -->
    <select id="selectByOpenid" resultMap="UserResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM users
        WHERE openid = #{openid}
        LIMIT 1
    </select>
</mapper>
