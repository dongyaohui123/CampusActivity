<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.ActivityCategoryRelMapper">

    <resultMap id="ActivityCategoryRelResultMap" type="com.campus.activity.entity.ActivityCategoryRel">
        <id property="activityId" column="activity_id"/>
        <id property="categoryId" column="category_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="ActivityCategoryLinkViewResultMap" type="com.campus.activity.entity.view.ActivityCategoryLinkView">
        <result property="activityId" column="activity_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        activity_id, category_id, created_at
    </sql>

    <!-- Insert one relation row. PK(activity_id, category_id) prevents duplicates. -->
    <insert id="insertRelation" parameterType="com.campus.activity.entity.ActivityCategoryRel">
        INSERT INTO activity_category_rel(activity_id, category_id, created_at)
        VALUES(#{activityId}, #{categoryId}, #{createdAt})
    </insert>

    <!-- Composite-key delete. -->
    <delete id="deleteByActivityIdAndCategoryId">
        DELETE FROM activity_category_rel
        WHERE activity_id = #{activityId}
          AND category_id = #{categoryId}
    </delete>

    <!-- Composite-key read. -->
    <select id="selectByActivityIdAndCategoryId" resultMap="ActivityCategoryRelResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM activity_category_rel
        WHERE activity_id = #{activityId}
          AND category_id = #{categoryId}
    </select>

    <!--
      Query all categories bound to one activity.
      - activity_id uses PK left-most column for fast lookup.
      - category name is joined for direct UI rendering.
    -->
    <select id="selectCategoryLinksByActivityId" resultMap="ActivityCategoryLinkViewResultMap">
        SELECT
            acr.activity_id,
            acr.category_id,
            ac.name AS category_name,
            acr.created_at
        FROM activity_category_rel acr
        INNER JOIN activity_categories ac ON ac.id = acr.category_id
        WHERE acr.activity_id = #{activityId}
        ORDER BY ac.sort_no ASC, ac.id ASC
    </select>

    <!--
      Reverse lookup: activities in one category.
      idx_activity_category_rel_category supports category_id filtering.
    -->
    <select id="selectActivityLinksByCategoryId" resultMap="ActivityCategoryLinkViewResultMap">
        SELECT
            acr.activity_id,
            acr.category_id,
            ac.name AS category_name,
            acr.created_at
        FROM activity_category_rel acr
        INNER JOIN activity_categories ac ON ac.id = acr.category_id
        WHERE acr.category_id = #{categoryId}
        ORDER BY acr.activity_id ASC
    </select>
</mapper>
