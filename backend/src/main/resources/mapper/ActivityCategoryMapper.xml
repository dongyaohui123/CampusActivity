<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.ActivityCategoryMapper">

    <resultMap id="ActivityCategoryResultMap" type="com.campus.activity.entity.ActivityCategory">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="name" column="name"/>
        <result property="sortNo" column="sort_no"/>
        <result property="status" column="status" javaType="com.campus.activity.enums.BasicStatus"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, parent_id, name, sort_no, status, created_at, updated_at
    </sql>

    <!--
      Query category children by parent id.
      Index idx_activity_categories_parent supports this lookup.
    -->
    <select id="selectByParentId" resultMap="ActivityCategoryResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM activity_categories
        WHERE
        <choose>
            <when test="parentId == null">
                parent_id IS NULL
            </when>
            <otherwise>
                parent_id = #{parentId}
            </otherwise>
        </choose>
        ORDER BY sort_no ASC, id ASC
    </select>

    <!--
      Query ACTIVE leaf categories only.
      Leaf means no ACTIVE children so organizer options default to selectable terminal types.
    -->
    <select id="selectActiveLeafCategories" resultMap="ActivityCategoryResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM activity_categories c
        WHERE c.status = 'ACTIVE'
          AND NOT EXISTS (
              SELECT 1
              FROM activity_categories child
              WHERE child.parent_id = c.id
                AND child.status = 'ACTIVE'
          )
        ORDER BY c.sort_no ASC, c.id ASC
    </select>

    <select id="selectActiveCategories" resultMap="ActivityCategoryResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM activity_categories
        WHERE status = 'ACTIVE'
        ORDER BY sort_no ASC, id ASC
    </select>
</mapper>
