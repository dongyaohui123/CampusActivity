<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.AuthTokenMapper">

    <resultMap id="AuthTokenResultMap" type="com.campus.activity.entity.AuthToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tokenHash" column="token_hash"/>
        <result property="tokenType" column="token_type" javaType="com.campus.activity.enums.TokenType"/>
        <result property="issuedAt" column="issued_at"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="revoked" column="revoked"/>
        <result property="revokedAt" column="revoked_at"/>
        <result property="deviceInfo" column="device_info"/>
        <result property="ipAddress" column="ip_address"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, token_hash, token_type, issued_at, expires_at, revoked, revoked_at, device_info, ip_address, created_at
    </sql>

    <!--
      Valid token query.
      Conditions:
      - revoked = 0
      - expires_at > current time
      Index notes:
      - idx_auth_tokens_user, idx_auth_tokens_expires_at, idx_auth_tokens_revoked.
    -->
    <select id="selectValidTokensByUserId" resultMap="AuthTokenResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM auth_tokens
        WHERE user_id = #{userId}
          AND revoked = 0
          AND expires_at <![CDATA[>]]> #{now}
        ORDER BY expires_at ASC, id ASC
    </select>
</mapper>
