page {
  height: 100%;
  background: linear-gradient(180deg, #f3f5fb 0%, #eceff6 100%);
}

.auth-scroll {
  height: calc(100vh - 92rpx);
}

.auth-page {
  min-height: 100%;
  padding: 28rpx 30rpx 40rpx;
  box-sizing: border-box;
}

.brand-block {
  text-align: center;
  margin: 10rpx 0 24rpx;
}

.brand-logo {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 14rpx;
  position: relative;
}

.logo-outer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 50%;
  background: linear-gradient(130deg, #5160f6 0%, #24cfff 100%);
}

.logo-inner {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 22rpx;
  bottom: 22rpx;
  border-radius: 50%;
  background: #f8f9fe;
}

.logo-bar {
  position: absolute;
  left: 60rpx;
  top: 58rpx;
  width: 52rpx;
  height: 16rpx;
  border-radius: 99rpx;
  background: linear-gradient(90deg, #34c5ff 0%, #27d7ff 100%);
}

.logo-dot {
  position: absolute;
  left: 36rpx;
  top: 36rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #5b65f7;
}

.brand-title {
  font-size: 54rpx;
  line-height: 1.2;
  color: #2f334a;
  font-weight: 700;
}

.brand-sub {
  font-size: 22rpx;
  color: #9ca0b3;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.auth-card {
  background: #ffffff;
  border-radius: 26rpx;
  border: 1rpx solid #eceef5;
  box-shadow: 0 16rpx 40rpx rgba(33, 46, 88, 0.08);
  padding: 22rpx 24rpx 26rpx;
}

.tab-wrap {
  background: #f3f5fb;
  border-radius: 999rpx;
  padding: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #71758b;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #ffffff;
  color: #232842;
  box-shadow: 0 8rpx 18rpx rgba(76, 87, 142, 0.15);
}

.panel-title {
  font-size: 50rpx;
  line-height: 1.1;
  color: #2a2e45;
  font-weight: 700;
  margin: 6rpx 0 16rpx;
}

.field-row {
  height: 92rpx;
  border: 1rpx solid #e8eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}

.field-icon {
  font-size: 34rpx;
  color: #a2a6b6;
  margin-right: 14rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #30354b;
}

.auth-placeholder {
  color: #b0b4c3;
}

.eye-btn {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye-btn::after {
  border: none;
}

.eye-icon {
  font-size: 34rpx;
  color: #a2a6b6;
}

.assist-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 2rpx 0 20rpx;
}

.remember-wrap {
  display: flex;
  align-items: center;
}

.remember-switch {
  width: 64rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #d8dcea;
  padding: 4rpx;
  box-sizing: border-box;
  transition: background 0.2s ease;
}

.remember-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(27, 31, 49, 0.24);
  transition: transform 0.2s ease;
}

.remember-switch.on {
  background: linear-gradient(120deg, #4e62f6 0%, #6277ff 100%);
}

.remember-switch.on .remember-dot {
  transform: translateX(28rpx);
}

.remember-text {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #42465b;
}

.action-link {
  font-size: 24rpx;
  color: #5f6cff;
}

.primary-btn {
  height: 92rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(95deg, #5062f6 0%, #647cff 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 14rpx 28rpx rgba(80, 98, 246, 0.33);
  margin-top: 8rpx;
}

.primary-btn::after {
  border: none;
}

.btn-arrow {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 28rpx;
  background: rgba(24, 35, 134, 0.3);
}

.divider {
  text-align: center;
  color: #9ca0b3;
  font-size: 28rpx;
  margin: 18rpx 0 14rpx;
}

.social-btn {
  height: 86rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 14rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 58, 108, 0.07);
}

.social-btn::after {
  border: none;
}

.social-icon {
  font-size: 38rpx;
  margin-right: 12rpx;
}

.social-icon.wechat {
  color: #1aad19;
}

.social-icon.qq {
  color: #12b7f5;
}

.social-text {
  font-size: 28rpx;
  color: #32364d;
}

.foot-row {
  text-align: center;
  margin-top: 8rpx;
  color: #4a4e66;
  font-size: 24rpx;
}

.switch-link {
  color: #5f6cff;
  margin-left: 6rpx;
  font-weight: 700;
}
