page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fb 220rpx, #f5f7fb 100%);
}

.list-scroll {
  flex: 1;
}

.card {
  border-radius: 18rpx;
  border-color: #e4ebf5;
}

.title {
  line-height: 1.4;
}

.muted {
  line-height: 1.6;
}
