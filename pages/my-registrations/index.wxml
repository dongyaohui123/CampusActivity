<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#FFFFFF"></navigation-bar>
<scroll-view class="list-scroll" scroll-y type="list">
  <view class="page-body">
    <view wx:if="{{!loginUser}}" class="card"><view class="muted">{{i18n.loginHint}}</view></view>
    <view wx:if="{{loading}}" class="empty">{{i18n.loading}}</view>

    <block wx:for="{{registrations}}" wx:key="registrationId">
      <view class="card">
        <view class="title mb-12">{{item.activityTitleDisplay}}</view>
        <view class="muted mb-12">{{i18n.locationLabel}}: {{item.location || '-'}}</view>
        <view class="muted mb-12">{{i18n.timeLabel}}: {{item.activityStartDisplay}} ~ {{item.activityEndDisplay}}</view>
        <view class="muted mb-12">{{i18n.statusLabel}}: {{item.registrationStatus}}</view>
        <button wx:if="{{item.registrationStatus === 'REGISTERED' || item.registrationStatus === 'CHECKED_IN'}}" size="mini" bindtap="onCancelTap" data-id="{{item.registrationId}}">{{i18n.cancelRegister}}</button>
      </view>
    </block>

    <view wx:if="{{!loading && registrations.length === 0 && loginUser}}" class="empty">{{i18n.empty}}</view>
  </view>
</scroll-view>