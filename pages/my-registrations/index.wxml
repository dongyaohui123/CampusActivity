<van-nav-bar title="{{i18n.navTitle}}" left-arrow bind:click-left="onClickNavLeft" />
<scroll-view class="list-scroll" scroll-y type="list">
  <view class="page-body">
    <van-empty wx:if="{{!loginUser}}" image="search" description="{{i18n.loginHint}}" />
    <van-empty wx:if="{{loading}}" image="search" description="{{i18n.loading}}" />

    <block wx:for="{{registrations}}" wx:key="registrationId">
      <view class="card">
        <van-card title="{{item.activityTitleDisplay}}" desc="{{item.location || '-'}}">
          <view slot="tags" class="card-time">{{i18n.timeLabel}}: {{item.activityStartDisplay}} ~ {{item.activityEndDisplay}}</view>
          <view slot="footer" class="card-footer">
            <view class="muted">{{i18n.statusLabel}}: {{item.registrationStatus}}</view>
            <view class="footer-actions">
              <van-button
                wx:if="{{item.canViewTicket}}"
                size="small"
                plain
                data-id="{{item.registrationId}}"
                bind:click="onViewTicketTap"
              >
                {{i18n.viewTicket}}
              </van-button>
              <van-button
                wx:if="{{item.canCancel}}"
                size="small"
                plain
                data-id="{{item.registrationId}}"
                bind:click="onCancelTap"
              >
                {{i18n.cancelRegister}}
              </van-button>
            </view>
          </view>
        </van-card>
      </view>
    </block>

    <van-empty wx:if="{{!loading && registrations.length === 0 && loginUser}}" image="search" description="{{i18n.empty}}" />
  </view>
</scroll-view>

<van-toast id="van-toast" />
<custom-modal id="custom-modal" />
