<van-nav-bar title="{{i18n.navTitle}}" left-arrow bind:click-left="onClickNavLeft" />
<scroll-view class="registration-scroll" scroll-y type="list">
  <view class="page-body">
    <van-empty wx:if="{{loading}}" image="search" description="{{i18n.loading}}" />

    <block wx:if="{{!loading}}">
      <view class="activity-card">
        <view class="section-title">{{i18n.activityLabel}}</view>
        <view class="activity-title">{{(activity && activity.title) || '未知活动'}}</view>
        <view class="activity-meta">{{i18n.timeLabel}}：{{activity.startDisplay}} ~ {{activity.endDisplay}}</view>
        <view class="activity-meta">{{i18n.locationLabel}}：{{(activity && activity.location) || '-'}}</view>
      </view>

      <block wx:for="{{registrations}}" wx:key="registrationId">
        <view class="registration-card">
          <view class="registration-top">
            <view class="registration-name">{{item.nickname || ('用户 #' + item.userId)}}</view>
            <view class="registration-status {{item.status === 'CHECKED_IN' ? 'is-success' : ''}}">
              {{item.statusText}}
            </view>
          </view>
          <view class="registration-meta">手机号：{{item.phone || '-'}}</view>
          <view class="registration-meta">报名时间：{{item.registeredDisplay}}</view>
          <view wx:if="{{item.status === 'CHECKED_IN'}}" class="registration-meta">签到时间：{{item.checkinDisplay}}</view>
        </view>
      </block>
      <van-empty wx:if="{{registrations.length === 0}}" image="search" description="{{i18n.empty}}" />
    </block>
  </view>
</scroll-view>

<van-toast id="van-toast" />
<van-notify id="van-notify" />
