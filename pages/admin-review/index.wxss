page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f3f5f9;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-body {
  padding: 0 20rpx 20rpx;
}

.with-bottom-space {
  padding-bottom: 44rpx;
}

.top-lite {
  background: #ffffff;
  border: 1rpx solid #e3e8f0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 16rpx rgba(33, 49, 79, 0.06);
  padding: 18rpx 20rpx;
  margin: 10rpx 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.top-lite-left {
  flex: 1;
  min-width: 0;
}

.top-lite-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f3746;
  line-height: 1.2;
}

.top-lite-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #667085;
  line-height: 1.5;
}

.top-lite-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: flex-end;
}

.top-lite-badge,
.top-lite-count {
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.top-lite-badge {
  color: #2f6cf3;
  background: #edf3ff;
  border: 1rpx solid #d8e6ff;
}

.top-lite-count {
  color: #ffffff;
  background: linear-gradient(135deg, #2f6cf3, #2b82ff);
  box-shadow: 0 8rpx 16rpx rgba(47, 108, 243, 0.2);
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e3e8f0;
  box-shadow: 0 8rpx 16rpx rgba(33, 49, 79, 0.06);
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.role-card {
  margin-top: 10rpx;
  padding: 28rpx 24rpx;
}

.state-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2a3343;
}

.state-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.6;
}

.form-card {
  margin-top: 2rpx;
}

.section-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8e6ff;
  background: #edf3ff;
  color: #2f6cf3;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  padding: 8rpx 14rpx;
  margin: 0 0 12rpx;
}

.form-tip {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #6f7787;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 2rpx 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #262e3d;
}

.section-count {
  min-width: 54rpx;
  height: 38rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 1rpx solid #d8e6ff;
  background: #edf3ff;
  color: #2f6cf3;
  font-size: 22rpx;
  font-weight: 700;
  padding: 0 12rpx;
}

.list-wrap {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.activity-card {
  background: #f7f8fb;
  border-color: #e2e7ef;
  box-shadow: 0 10rpx 24rpx rgba(22, 34, 54, 0.09);
  margin-bottom: 0;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #2a3343;
  line-height: 1.4;
}

.status-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
}

.status-success {
  color: #0f8a5f;
  background: #e8f8f2;
}

.status-warning {
  color: #b7791f;
  background: #fff7e8;
}

.status-danger {
  color: #c2410c;
  background: #fff1eb;
}

.status-muted {
  color: #667085;
  background: #f2f4f7;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.meta-row:last-of-type {
  margin-bottom: 0;
}

.meta-label {
  width: 132rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: #6f7787;
}

.meta-value {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #344054;
  line-height: 1.5;
  word-break: break-all;
}

.action-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.action-btn {
  --button-border-radius: 12rpx;
  --button-primary-border-color: #2f6cf3;
  --button-primary-background-color: #2f6cf3;
  --button-primary-color: #ffffff;
}

.action-btn-ghost {
  --button-border-radius: 12rpx;
  --button-default-color: #2f6cf3;
  --button-default-border-color: #cfe0ff;
  --button-default-background-color: #ffffff;
}

.list-op-btn {
  min-width: 132rpx;
}

.fade-up {
  opacity: 0;
  transform: translateY(12rpx);
  animation: fadeUp 420ms ease forwards;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
