page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fb 220rpx, #f5f7fb 100%);
}

.page-scroll {
  flex: 1;
}

.input {
  background: #f7faff;
  border: 1rpx solid #d9e4f4;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
}

.card {
  border-radius: 20rpx;
  border-color: #e4ebf5;
}
