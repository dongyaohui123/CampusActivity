<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#FFFFFF"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-body">
    <view wx:if="{{operatorRole !== 'ADMIN'}}" class="card">
      <view class="muted">{{i18n.roleHintPrefix}} {{operatorRole}}, {{i18n.roleHintSuffix}}</view>
    </view>

    <view wx:if="{{operatorRole === 'ADMIN'}}" class="card">
      <view class="title mb-12">{{i18n.reviewCommentTitle}}</view>
      <input class="input" value="{{reviewComment}}" bindinput="onCommentInput" placeholder="{{i18n.reviewCommentPlaceholder}}" />
    </view>

    <view wx:if="{{loading}}" class="empty">{{i18n.loading}}</view>

    <block wx:for="{{pendingList}}" wx:key="activityId">
      <view class="card">
        <view class="title mb-12">{{item.title}}</view>
        <view class="muted mb-12">{{i18n.activityIdLabel}}: {{item.activityId}} / {{i18n.organizerLabel}}: {{item.organizerId}}</view>
        <view class="muted mb-12">{{i18n.timeLabel}}: {{item.startDisplay}} ~ {{item.endDisplay}}</view>
        <view class="muted mb-12">{{i18n.reviewStatusLabel}}: {{item.reviewStatus}}</view>
        <view class="row gap-12">
          <button type="primary" size="mini" data-id="{{item.activityId}}" bindtap="onApproveTap">{{i18n.approve}}</button>
          <button size="mini" data-id="{{item.activityId}}" bindtap="onRejectTap">{{i18n.reject}}</button>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && pendingList.length === 0 && operatorRole === 'ADMIN'}}" class="empty">{{i18n.empty}}</view>
  </view>
</scroll-view>
