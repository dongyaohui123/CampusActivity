.managed-scroll {
  height: 100vh;
  background: #f6f7fb;
}

.page-body {
  padding: 24rpx;
}

.activity-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.activity-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.status-pill {
  font-size: 22rpx;
  color: #1677ff;
  background: #eef5ff;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.activity-meta {
  color: #666;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
