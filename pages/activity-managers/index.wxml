<van-nav-bar title="{{i18n.navTitle}}" left-arrow bind:click-left="onClickNavLeft" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-body">
    <view wx:if="{{operatorRole !== 'ORGANIZER'}}" class="card role-card">
      <view class="muted">{{i18n.roleHint}}</view>
    </view>

    <view wx:if="{{operatorRole === 'ORGANIZER'}}" class="card">
      <view class="row-label">{{i18n.activityTitleLabel}}</view>
      <view class="activity-title">{{activityTitle || ('#' + activityId)}}</view>
    </view>

    <view wx:if="{{operatorRole === 'ORGANIZER'}}" class="card">
      <van-field
        type="text"
        label="{{i18n.usernameLabel}}"
        value="{{managerUsernameInput}}"
        bind:change="onUsernameInput"
        placeholder="{{i18n.usernamePlaceholder}}"
      />
      <view class="action-row">
        <van-button type="primary" size="small" bind:click="onAddTap">{{i18n.addButton}}</van-button>
      </view>
    </view>

    <view wx:if="{{operatorRole === 'ORGANIZER'}}" class="section-head">
      <view class="section-title">{{i18n.managerList}}</view>
      <view class="section-count">{{managers.length}}</view>
    </view>

    <van-empty wx:if="{{loading}}" image="search" description="{{i18n.loading}}" />

    <block wx:for="{{managers}}" wx:key="userId">
      <view class="card manager-card">
        <view class="manager-top">
          <view class="manager-name">{{item.nickname || ('用户#' + item.userId)}}</view>
          <view class="manager-phone">{{item.phone || '-'}}</view>
        </view>
        <view class="manager-meta">{{i18n.permissionLabel}}：{{item.permissionText}}</view>
        <view class="manager-meta">{{i18n.statusLabel}}：{{item.status || '-'}}</view>
        <view class="manager-meta">{{i18n.createdAtLabel}}：{{item.createdAtDisplay || '-'}}</view>
        <view class="action-row">
          <van-button size="small" plain type="danger" data-user-id="{{item.userId}}" bind:click="onRemoveTap">{{i18n.remove}}</van-button>
        </view>
      </view>
    </block>

    <van-empty wx:if="{{!loading && managers.length === 0 && operatorRole === 'ORGANIZER'}}" image="search" description="{{i18n.empty}}" />
  </view>
</scroll-view>

<van-toast id="van-toast" />
<custom-modal id="custom-modal" />
