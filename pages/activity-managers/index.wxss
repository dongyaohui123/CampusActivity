.page-scroll {
  height: 100vh;
  background: #f6f7fb;
}

.page-body {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.role-card .muted {
  color: #888;
  font-size: 26rpx;
}

.row-label {
  color: #666;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.activity-title {
  color: #222;
  font-size: 30rpx;
  font-weight: 600;
}

.action-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.section-count {
  color: #999;
  font-size: 24rpx;
}

.manager-card .manager-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.manager-name {
  color: #222;
  font-size: 28rpx;
  font-weight: 600;
}

.manager-phone {
  color: #666;
  font-size: 24rpx;
}

.manager-meta {
  color: #555;
  font-size: 24rpx;
  margin-top: 6rpx;
}
