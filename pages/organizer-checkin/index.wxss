page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f4f7fb;
}

.checkin-scroll {
  flex: 1;
  min-height: 0;
}

.role-card,
.activity-card,
.action-card,
.registration-card,
.stat-card {
  background: #ffffff;
  border-radius: 22rpx;
  border: 1rpx solid #e3e8f0;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.role-card,
.activity-card,
.action-card,
.registration-card {
  padding: 24rpx;
}

.role-card {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #475467;
}

.activity-card {
  margin-top: 20rpx;
}

.section-title,
.section-head {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.activity-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.activity-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
}

.stats-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stat-card {
  padding: 20rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.action-card {
  margin-top: 16rpx;
}

.manual-section {
  margin-top: 18rpx;
}

.manual-label {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}

.section-head {
  margin: 22rpx 2rpx 14rpx;
}

.registration-card {
  margin-bottom: 14rpx;
}

.registration-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.registration-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.registration-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.registration-status.is-success {
  background: #ecfdf3;
  color: #027a48;
}

.registration-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
}
