page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fb 220rpx, #f5f7fb 100%);
}

.detail-scroll {
  flex: 1;
}

.card {
  border-radius: 20rpx;
  border-color: #e4ebf5;
}

.muted {
  line-height: 1.65;
}

button {
  min-width: 180rpx;
}
