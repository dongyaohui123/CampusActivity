<navigation-bar title="{{i18n.navTitle}}" back="{{true}}" color="black" background="#FFFFFF"></navigation-bar>
<scroll-view class="detail-scroll" scroll-y type="list">
  <view class="page-body">
    <view wx:if="{{loading}}" class="empty">{{i18n.loading}}</view>

    <view wx:if="{{activity}}" class="card">
      <view class="title mb-12">{{activity.title}}</view>
      <view class="muted mb-12">{{i18n.statusLabel}}: {{activity.status || '-'}}</view>
      <view class="muted mb-12">{{i18n.locationLabel}}: {{activity.location || '-'}}</view>
      <view class="muted mb-12">{{i18n.timeLabel}}: {{activity.startDisplay}} ~ {{activity.endDisplay}}</view>
      <view class="muted mb-12">{{i18n.deadlineLabel}}: {{activity.deadlineDisplay}}</view>
      <view class="muted mb-12">{{i18n.summaryLabel}}: {{activity.summary || '-'}}</view>
      <view>{{i18n.contentLabel}}: {{activity.content || '-'}}</view>
    </view>

    <view class="card">
      <view class="title mb-12">{{i18n.registerOps}}</view>
      <view wx:if="{{operatorRole !== 'STUDENT'}}" class="muted mb-12">{{i18n.studentOnly}}</view>
      <view wx:if="{{currentRegistration}}" class="muted mb-12">{{i18n.currentStatus}}: {{currentRegistration.registrationStatus}}</view>
      <view class="row gap-12">
        <button wx:if="{{canRegister}}" type="primary" bindtap="onRegisterTap">{{i18n.registerNow}}</button>
        <button wx:if="{{canCancel}}" bindtap="onCancelTap">{{i18n.cancelRegister}}</button>
      </view>
    </view>
  </view>
</scroll-view>