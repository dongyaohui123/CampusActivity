<view class="detail-page">
  <view class="top-panel">
    <view class="status-safe"></view>
    <view class="nav-row">
      <view class="nav-left">
        <view class="nav-btn" bindtap="onClickNavLeft">&lt;</view>
        <view class="nav-btn" data-action="home" bindtap="onQuickActionTap">H</view>
      </view>
      <text class="nav-title">{{i18n.navTitle}}</text>
      <view class="nav-right">
        <view class="nav-btn" data-action="share" bindtap="onQuickActionTap">...</view>
        <view class="nav-btn" data-action="service" bindtap="onQuickActionTap">S</view>
      </view>
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y type="list">
    <view class="page-body detail-body">
      <view wx:if="{{loading}}" class="card loading-card">
        <view class="loading-title">{{i18n.loading}}</view>
        <view class="loading-line"></view>
        <view class="loading-line"></view>
        <view class="loading-line short"></view>
      </view>

      <block wx:if="{{!loading && activity}}">
        <view class="hero-card fade-up">
          <image class="hero-image" src="{{coverDisplay}}" mode="aspectFill" />
          <view class="hero-mask">
            <text class="hero-status">{{activity.statusText}}</text>
            <text class="hero-deadline">{{i18n.deadlineLabel}} {{activity.deadlineDisplay}}</text>
          </view>
        </view>

        <view class="card info-card fade-up delay-1">
          <view class="title mb-12">{{activity.title || i18n.untitled}}</view>
          <view class="meta-row">
            <text class="meta-label">{{i18n.locationLabel}}</text>
            <text class="meta-value">{{activity.location || i18n.emptyText}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">{{i18n.timeLabel}}</text>
            <text class="meta-value">{{activity.startDisplay}} ~ {{activity.endDisplay}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">{{i18n.currentStatus}}</text>
            <text class="meta-value">{{registrationStatusText}}</text>
          </view>
        </view>

        <view class="card detail-card fade-up delay-2">
          <view class="section-title">{{i18n.summaryLabel}}</view>
          <view class="summary-text">{{activity.summary || i18n.summaryEmpty}}</view>
          <view class="section-title content-title">{{i18n.contentLabel}}</view>
          <view class="detail-content">{{activity.content || i18n.contentEmpty}}</view>
        </view>
      </block>

      <van-empty wx:if="{{!loading && !activity}}" image="search" description="{{i18n.loadFailed}}" />
    </view>
  </scroll-view>

  <view wx:if="{{activity}}" class="action-bar">
    <view class="quick-group">
      <view class="quick-btn" data-action="favorite" bindtap="onQuickActionTap">
        <view class="quick-icon">
          <van-icon name="star-o" class="quick-vant-icon" />
        </view>
        <text class="quick-label">{{i18n.favorite}}</text>
      </view>
      <view class="quick-btn" data-action="share" bindtap="onQuickActionTap">
        <view class="quick-icon">
          <van-icon name="share-o" class="quick-vant-icon" />
        </view>
        <text class="quick-label">{{i18n.share}}</text>
      </view>
      <view class="quick-btn" data-action="service" bindtap="onQuickActionTap">
        <view class="quick-icon">
          <van-icon name="service-o" class="quick-vant-icon" />
        </view>
        <text class="quick-label">{{i18n.service}}</text>
      </view>
    </view>

    <button class="cta-btn {{ctaMode}}" bindtap="onCtaTap" disabled="{{ctaMode === 'disabled'}}">
      <text class="cta-main">{{ctaText}}</text>
      <text class="cta-sub">{{ctaHint}}</text>
    </button>
  </view>
</view>

<van-toast id="van-toast" />
<van-notify id="van-notify" />
