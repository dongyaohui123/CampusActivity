page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
}

.card {
  border-radius: 20rpx;
  border-color: #e4ebf5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}
