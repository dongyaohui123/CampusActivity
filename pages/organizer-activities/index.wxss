page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f3f5f9 0%, #f4f7fb 100%);
}

.page-scroll {
  flex: 1;
}

.page-body {
  padding: 0 20rpx 24rpx;
}

.with-bottom-space {
  padding-bottom: 44rpx;
}

.top-panel {
  background: linear-gradient(160deg, rgba(205, 212, 226, 0.58), rgba(236, 239, 246, 0.56) 45%, rgba(243, 245, 249, 1));
  border-radius: 0 0 24rpx 24rpx;
  border-bottom: 1rpx solid #d9e0ec;
  padding: 16rpx 8rpx 14rpx;
  margin: 0 -8rpx 12rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f3746;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #667085;
}

.page-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #2f6cf3;
  background: #edf3ff;
  border: 1rpx solid #d8e6ff;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e3e8f0;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.06);
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.form-card {
  padding-bottom: 16rpx;
}

.role-card {
  margin-top: 8rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.muted {
  color: #667085;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #273043;
  margin: 6rpx 2rpx 12rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 8rpx;
}

.action-dock {
  margin-top: 10rpx;
}

.row {
  display: flex;
  align-items: center;
}

.gap-12 {
  gap: 12rpx;
}

.mb-12 {
  margin-bottom: 12rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.fade-up {
  opacity: 0;
  transform: translateY(12rpx);
  animation: fadeUp 420ms ease forwards;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
