page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.mine-scroll {
  flex: 1;
  min-height: 0;
}

.mine-page {
  padding-top: 12rpx;
}

.profile-header {
  margin: 24rpx;
  border-radius: 28rpx;
  padding: 26rpx 24rpx 28rpx;
  background: linear-gradient(128deg, #2f7cf5 0%, #4ba8ff 100%);
  box-shadow: 0 14rpx 36rpx rgba(47, 124, 245, 0.24);
}

.header-top {
  display: flex;
  align-items: center;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: inherit;
  flex-shrink: 0;
}

.avatar-text {
  width: 100%;
  height: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: inherit;
  background: #ffffff;
  color: #2f7cf5;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.profile-edit-btn {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #2f7cf5;
  font-size: 22rpx;
  background: #ffffff;
}

.user-meta {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-id {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.88);
}

.user-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.4;
}

.count-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-item {
  width: 33.3%;
  text-align: center;
}

.count-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ffffff;
}

.count-label {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
}

.quick-card {
  margin: -12rpx 24rpx 0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 45, 61, 0.09);
  border: 1rpx solid #edf0f5;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 20rpx 8rpx 16rpx;
}

.quick-item {
  padding: 8rpx 8rpx 10rpx;
  text-align: center;
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #edf3ff;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon-glyph {
  font-size: 34rpx !important;
  color: #2f7cf5 !important;
}

.quick-title {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.quick-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7a8699;
  line-height: 1.35;
  min-height: 54rpx;
}

.activity-panel {
  margin: 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #edf0f5;
  box-shadow: 0 10rpx 26rpx rgba(31, 45, 61, 0.09);
  padding: 20rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.panel-more {
  color: #6f7f96;
  font-size: 22rpx;
}

.panel-empty-login {
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #f6f9ff;
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.empty-text {
  color: #5b6b82;
  font-size: 24rpx;
  line-height: 1.5;
}

.activity-tabs {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eef2f6;
}

.activity-tab {
  position: relative;
  padding: 14rpx 14rpx 16rpx;
  margin-right: 18rpx;
  color: #667085;
  font-size: 26rpx;
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
  display: flex;
  align-items: center;
}

.activity-tab-active {
  color: #2f7cf5;
  font-weight: 600;
  border-bottom-color: #2f7cf5;
}

.tab-badge {
  margin-left: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  padding: 0 8rpx;
  line-height: 30rpx;
  text-align: center;
  background: #ff5a5f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.activity-card {
  margin-top: 18rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 16rpx;
  padding: 20rpx;
}

.activity-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.activity-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  line-height: 1.4;
}

.status-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
}

.status-success {
  color: #0f8a5f;
  background: #e8f8f2;
}

.status-warning {
  color: #b7791f;
  background: #fff7e8;
}

.status-danger {
  color: #c2410c;
  background: #fff1eb;
}

.status-muted {
  color: #667085;
  background: #f2f4f7;
}

.activity-meta {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.activity-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.logout-wrap {
  margin: 0 24rpx 24rpx;
}

.logout-btn {
  width: 100%;
  border-radius: 20rpx !important;
  border-color: #ffd7d7 !important;
  color: #ee0a24 !important;
  background: #ffffff !important;
}

.edit-popup {
  padding: 26rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.edit-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.edit-row {
  margin-top: 22rpx;
}

.edit-label {
  margin-bottom: 10rpx;
  color: #4a5a73;
  font-size: 23rpx;
}

.avatar-row .avatar-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.popup-avatar-preview {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f5f8;
  flex-shrink: 0;
}

.avatar-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #2f7cf5;
  background: #edf3ff;
  border: 1rpx solid #d4e5ff;
  white-space: nowrap;
}

.avatar-btn::after {
  border: 0;
}

.edit-footer {
  margin-top: 28rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}
