page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f3f4f6;
}

.mine-scroll {
  flex: 1;
}

.profile-header {
  background: linear-gradient(180deg, #2f80ed 0%, #30c7d8 100%);
  color: #fff;
  padding: 24rpx 24rpx 30rpx 24rpx;
}

.login-panel {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 20rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.login-input {
  background: rgba(255, 255, 255, 0.95);
  color: #111827;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
}

.login-btn {
  background: #1d4ed8;
  color: #fff;
}

.user-panel {
  padding: 8rpx 0;
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
}

.role-tag {
  background: rgba(255, 255, 255, 0.24);
  border-radius: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-item {
  width: 33.3%;
  text-align: center;
}

.count-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.count-label {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.menu-card {
  margin: 24rpx;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.menu-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f1f3f5;
  color: #1f2937;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger {
  color: #ef4444;
}

