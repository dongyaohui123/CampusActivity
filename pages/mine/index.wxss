page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.mine-scroll {
  flex: 1;
}

.profile-header {
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #edf1f6;
}

.auth-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.auth-switch {
  display: flex;
  background: #f2f4f7;
  border-radius: 10rpx;
  padding: 4rpx;
}

.auth-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  padding: 12rpx 0;
  border-radius: 8rpx;
}

.auth-tab.active {
  background: #ffffff;
  color: #111827;
  font-weight: 600;
}

.auth-input {
  background: #f8fafc;
  color: #111827;
  border-radius: 10rpx;
  border: 1rpx solid #e5e7eb;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
}

.auth-btn {
  margin-top: 6rpx;
  background: #2563eb;
  color: #ffffff;
}

.auth-tip {
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
  margin-top: 4rpx;
}

.user-panel {
  padding: 6rpx 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.role-tag {
  background: #eef2ff;
  color: #1d4ed8;
  border-radius: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-item {
  width: 33.3%;
  text-align: center;
}

.count-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #111827;
}

.count-label {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: #6b7280;
}

.menu-card {
  margin: 0 24rpx 24rpx;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
  border: 1rpx solid #edf1f6;
}

.menu-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  color: #1f2937;
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger {
  color: #ef4444;
}

