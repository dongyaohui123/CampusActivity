page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.mine-scroll {
  flex: 1;
}

.mine-page {
  padding-top: 12rpx;
}

.profile-header {
  margin: 24rpx;
  border-radius: 28rpx;
  padding: 26rpx 24rpx 28rpx;
  background: linear-gradient(128deg, #2f7cf5 0%, #4ba8ff 100%);
  box-shadow: 0 14rpx 36rpx rgba(47, 124, 245, 0.24);
}

.header-top {
  display: flex;
  align-items: center;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  color: #2f7cf5;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 92rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 0 10rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.4;
}

.settings-tag {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 24rpx;
}

.count-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-item {
  width: 33.3%;
  text-align: center;
}

.count-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ffffff;
}

.count-label {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
}

.entry-card {
  margin: -12rpx 24rpx 0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 45, 61, 0.09);
  border: 1rpx solid #edf0f5;
  display: flex;
  align-items: stretch;
  overflow: hidden;
}

.entry-item {
  flex: 1;
  padding: 24rpx 20rpx 22rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a8699;
  line-height: 1.35;
}

.entry-divider {
  width: 1rpx;
  margin: 20rpx 0;
  background: #eceff4;
}

.menu-card {
  margin: 22rpx 0 24rpx;
}

.menu-card .van-cell-group--inset {
  margin: 0 24rpx !important;
  border-radius: 20rpx !important;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(31, 45, 61, 0.07);
}

.menu-card .van-cell {
  padding-top: 30rpx !important;
  padding-bottom: 30rpx !important;
  font-size: 29rpx !important;
}
