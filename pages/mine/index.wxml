<van-nav-bar title="{{i18n.navTitle}}" />

<scroll-view class="mine-scroll" scroll-y type="list">
  <view class="with-bottom-nav mine-page">
    <view class="profile-header">
      <view class="header-top">
        <view class="avatar">{{avatarText}}</view>
        <view class="user-meta">
          <view class="user-name">{{loginUser ? (loginUser.nickname || loginUser.username) : i18n.guestName}}</view>
          <view wx:if="{{loginUser}}" class="user-id">{{i18n.userIdPrefix}}{{loginUser.id}}</view>
          <view class="user-desc">{{loginUser ? i18n.welcomeBack : i18n.guestDesc}}</view>
        </view>
      </view>

      <view class="count-row">
        <view class="count-item">
          <view class="count-num">{{stats.participatedCount}}</view>
          <view class="count-label">{{i18n.participatedCount}}</view>
        </view>
        <view class="count-item">
          <view class="count-num">{{stats.initiatedCount}}</view>
          <view class="count-label">{{i18n.initiatedCount}}</view>
        </view>
        <view class="count-item">
          <view class="count-num">{{stats.managedOrgCount}}</view>
          <view class="count-label">{{i18n.managedOrgCount}}</view>
        </view>
      </view>
    </view>

    <view class="quick-card">
      <view wx:for="{{quickActions}}" wx:key="action" class="quick-item" data-action="{{item.action}}" bindtap="onQuickActionTap">
        <view class="quick-icon">
          <van-icon name="{{item.iconName}}" custom-class="quick-icon-glyph" />
        </view>
        <view class="quick-title">{{item.title}}</view>
        <view class="quick-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="activity-panel">
      <view class="panel-head">
        <view class="panel-title">{{i18n.myActivity}}</view>
        <view class="panel-more" data-action="{{sectionEntry.action}}" bindtap="onSectionMoreTap">{{sectionEntry.text}}</view>
      </view>

      <view wx:if="{{!loginUser}}" class="panel-empty-login">
        <view class="empty-text">{{i18n.guestActivityHint}}</view>
        <van-button size="small" type="primary" data-action="login" bind:click="onMenuTap">{{i18n.goLogin}}</van-button>
      </view>

      <block wx:if="{{loginUser}}">
        <view wx:if="{{activityTabs.length}}" class="activity-tabs">
          <view
            wx:for="{{activityTabs}}"
            wx:key="key"
            class="activity-tab {{activeActivityTab === item.key ? 'activity-tab-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onActivityTabTap"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{item.count > 0}}" class="tab-badge">{{item.count}}</text>
          </view>
        </view>

        <van-empty wx:if="{{loadingActivities}}" image="search" description="{{i18n.loading}}" />

        <block wx:for="{{filteredActivityCards}}" wx:key="itemKey">
          <view class="activity-card">
            <view class="activity-top">
              <view class="activity-title">{{item.title}}</view>
              <view class="status-pill status-{{item.statusTone}}">{{item.statusText}}</view>
            </view>
            <view class="activity-meta">{{i18n.locationLabel}}：{{item.locationText}}</view>
            <view class="activity-meta">{{i18n.timeLabel}}：{{item.timeText}}</view>
            <view class="activity-actions">
              <van-button
                wx:if="{{item.secondaryAction}}"
                size="small"
                plain
                data-action="{{item.secondaryAction.action}}"
                data-item-id="{{item.secondaryAction.itemId}}"
                bind:click="onCardActionTap"
              >
                {{item.secondaryAction.label}}
              </van-button>
              <van-button
                wx:if="{{item.primaryAction}}"
                size="small"
                type="primary"
                data-action="{{item.primaryAction.action}}"
                data-item-id="{{item.primaryAction.itemId}}"
                bind:click="onCardActionTap"
              >
                {{item.primaryAction.label}}
              </van-button>
            </view>
          </view>
        </block>

        <van-empty wx:if="{{!loadingActivities && filteredActivityCards.length === 0}}" image="search" description="{{activityEmptyText}}" />
      </block>
    </view>

    <view wx:if="{{loginUser}}" class="logout-wrap">
      <van-button type="default" custom-class="logout-btn" bind:click="onLogoutTap">{{i18n.logout}}</van-button>
    </view>
  </view>
</scroll-view>

<van-tabbar active="{{bottomActive}}" bind:change="onBottomTabChange" safe-area-inset-bottom>
  <van-tabbar-item name="home" icon="home-o">首页</van-tabbar-item>
  <van-tabbar-item name="find" icon="search">找活动</van-tabbar-item>
  <van-tabbar-item name="mine" icon="contact">我的</van-tabbar-item>
</van-tabbar>

<van-toast id="van-toast" />
<van-notify id="van-notify" />
