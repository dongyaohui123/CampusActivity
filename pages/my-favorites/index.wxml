<van-nav-bar title="{{i18n.navTitle}}" left-arrow bind:click-left="onClickNavLeft" />

<scroll-view class="favorites-scroll" scroll-y type="list">
  <view class="favorites-page">
    <van-empty wx:if="{{!loginUser}}" image="search" description="{{i18n.loginHint}}" />
    <van-empty wx:if="{{loading}}" image="search" description="{{i18n.loading}}" />

    <block wx:for="{{favorites}}" wx:key="activityId">
      <view class="activity-card">
        <view class="activity-top">
          <view class="activity-title">{{item.titleDisplay}}</view>
          <view class="status-pill status-{{item.statusTone}}">{{item.statusText}}</view>
        </view>
        <view class="activity-summary">{{item.summaryDisplay}}</view>
        <view class="activity-meta">{{i18n.locationLabel}}：{{item.locationDisplay}}</view>
        <view class="activity-meta">{{i18n.timeLabel}}：{{item.startDisplay}} ~ {{item.endDisplay}}</view>
        <view class="activity-meta">{{i18n.favoriteTimeLabel}}：{{item.favoritedAtDisplay}}</view>
        <view class="activity-actions">
          <van-button size="small" plain data-id="{{item.activityId}}" bind:click="onUnfavoriteTap">
            {{i18n.unfavorite}}
          </van-button>
          <van-button size="small" type="primary" data-id="{{item.activityId}}" bind:click="onViewDetailTap">
            {{i18n.viewDetail}}
          </van-button>
        </view>
      </view>
    </block>

    <van-empty wx:if="{{!loading && favorites.length === 0 && loginUser}}" image="search" description="{{i18n.empty}}" />
  </view>
</scroll-view>

<van-toast id="van-toast" />
<van-notify id="van-notify" />
