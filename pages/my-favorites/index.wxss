page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.favorites-scroll {
  flex: 1;
  min-height: 0;
}

.favorites-page {
  padding: 24rpx;
}

.activity-card {
  margin-bottom: 18rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 16rpx;
  padding: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 45, 61, 0.09);
}

.activity-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.activity-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  line-height: 1.4;
}

.activity-summary {
  margin-top: 10rpx;
  color: #4a5a73;
  font-size: 23rpx;
  line-height: 1.6;
}

.status-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
}

.status-success {
  color: #0f8a5f;
  background: #e8f8f2;
}

.status-warning {
  color: #b7791f;
  background: #fff7e8;
}

.status-danger {
  color: #c2410c;
  background: #fff1eb;
}

.status-muted {
  color: #667085;
  background: #f2f4f7;
}

.activity-meta {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.activity-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}
