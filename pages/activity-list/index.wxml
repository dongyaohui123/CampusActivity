<van-nav-bar title="{{i18n.navTitle}}" />

<scroll-view class="find-scroll" scroll-y type="list">
  <view class="page-body with-bottom-nav">
    <view class="search-wrap card">
      <van-search
        value="{{keyword}}"
        placeholder="{{i18n.searchPlaceholder}}"
        shape="round"
        bind:change="onKeywordInput"
      />
    </view>

    <view class="category-wrap card">
      <van-tabs active="{{selectedCategory}}" bind:change="onCategoryChange" sticky="{{false}}" line-width="22">
        <block wx:for="{{categories}}" wx:key="key">
          <van-tab title="{{item.label}}" name="{{item.key}}"></van-tab>
        </block>
      </van-tabs>
    </view>

    <van-empty wx:if="{{loading}}" image="search" description="{{i18n.loading}}" />

    <view class="list-wrap">
      <block wx:for="{{displayList}}" wx:key="id">
        <view class="card list-card" bindtap="goDetail" data-id="{{item.id}}">
          <van-card thumb="{{item.cover}}" title="{{item.title}}" desc="{{item.locationDisplay}}">
            <view slot="tags" class="card-time">{{item.timeDisplay}}</view>
          </van-card>
        </view>
      </block>
    </view>

    <van-empty wx:if="{{!loading && displayList.length === 0}}" image="search" description="{{i18n.empty}}" />
  </view>
</scroll-view>

<van-tabbar active="{{bottomActive}}" bind:change="onBottomTabChange" safe-area-inset-bottom>
  <van-tabbar-item name="home" icon="home-o">首页</van-tabbar-item>
  <van-tabbar-item name="find" icon="search">找活动</van-tabbar-item>
  <van-tabbar-item name="mine" icon="contact">我的</van-tabbar-item>
</van-tabbar>

<van-toast id="van-toast" />
<van-notify id="van-notify" />
