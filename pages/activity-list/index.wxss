page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.find-scroll {
  flex: 1;
}

.search-wrap {
  padding: 12rpx;
  border: 1rpx solid #edf1f6;
}

.search-input {
  background: #f2f4f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
}

.category-wrap {
  padding: 10rpx 0;
  border: 1rpx solid #edf1f6;
}

.category-scroll {
  white-space: nowrap;
}

.category-row {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.category-item {
  margin: 0 16rpx;
  color: #6b7280;
  padding: 8rpx 0;
  border-bottom: 4rpx solid transparent;
  font-size: 26rpx;
}

.category-item.active {
  color: #2563eb;
  border-bottom-color: #2563eb;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-card {
  width: 48%;
  background: #ffffff;
  border-radius: 14rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #edf1f6;
}

.grid-cover {
  width: 100%;
  height: 220rpx;
  background: #edf2f7;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  padding: 14rpx 14rpx 8rpx;
  min-height: 90rpx;
  line-height: 1.4;
}

.grid-meta {
  color: #6b7280;
  font-size: 24rpx;
  padding: 0 14rpx 10rpx;
}

