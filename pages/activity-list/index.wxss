page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fb 220rpx, #f5f7fb 100%);
}

.find-scroll {
  flex: 1;
}

.search-wrap {
  padding: 12rpx;
  border: 1rpx solid #e4ebf5;
  border-radius: 18rpx;
}

.search-input {
  background: #f4f7fc;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  border: 1rpx solid #e7edf7;
}

.category-wrap {
  padding: 10rpx 0;
  border: 1rpx solid #e4ebf5;
  border-radius: 18rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-row {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.category-item {
  margin: 0 12rpx;
  color: #6b7280;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  font-size: 24rpx;
}

.category-item.active {
  color: #2f6cf3;
  background: #edf3ff;
  border-color: #d7e5ff;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-card {
  width: 48%;
  background: #ffffff;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e4ebf5;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.grid-cover {
  width: 100%;
  height: 220rpx;
  background: #edf2f7;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  padding: 14rpx 14rpx 8rpx;
  min-height: 90rpx;
  line-height: 1.4;
}

.grid-meta {
  color: #6b7280;
  font-size: 24rpx;
  padding: 0 14rpx 10rpx;
}
