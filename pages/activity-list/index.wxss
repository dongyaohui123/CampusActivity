page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f3f4f6;
}

.find-scroll {
  flex: 1;
}

.search-wrap {
  padding: 16rpx;
}

.search-input {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.category-wrap {
  padding: 12rpx 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-row {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}

.category-item {
  margin: 0 14rpx;
  color: #6b7280;
  padding-bottom: 10rpx;
  border-bottom: 4rpx solid transparent;
}

.category-item.active {
  color: #2f80ed;
  border-bottom-color: #2f80ed;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-card {
  width: 48%;
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.grid-cover {
  width: 100%;
  height: 220rpx;
  background: #edf2f7;
}

.grid-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  padding: 14rpx 14rpx 8rpx 14rpx;
  min-height: 86rpx;
}

.grid-meta {
  color: #6b7280;
  font-size: 25rpx;
  padding: 0 14rpx 10rpx 14rpx;
}

