<van-nav-bar title="{{i18n.navTitle}}" />

<scroll-view class="home-scroll" scroll-y type="list">
  <view class="page-body with-bottom-nav">
    <view class="card banner-card">
      <swiper indicator-dots autoplay interval="5000" circular>
        <block wx:for="{{banners}}" wx:key="*this">
          <swiper-item>
            <image class="banner-image" src="{{item}}" mode="aspectFill" />
            <view class="banner-mask">
              <text class="banner-title">{{i18n.navTitle}}</text>
              <text class="banner-sub">{{i18n.bannerSub}}</text>
            </view>
          </swiper-item>
        </block>
      </swiper>
    </view>

    <view class="card quick-card">
      <van-grid border="{{false}}" column-num="3">
        <van-grid-item icon="friends-o" text="{{i18n.myActivity}}" data-action="myActivity" bind:click="onQuickTap" />
        <van-grid-item icon="cluster-o" text="{{i18n.myOrg}}" data-action="myOrg" bind:click="onQuickTap" />
        <van-grid-item icon="plus" text="{{i18n.publish}}" data-action="publish" bind:click="onQuickTap" />
      </van-grid>
    </view>

    <view class="section-title row-between">
      <text>{{i18n.recommend}}</text>
    </view>

    <van-empty wx:if="{{loading}}" image="search" description="{{i18n.loading}}" />

    <block wx:for="{{recommendList}}" wx:key="id">
      <view class="card activity-card-wrap" bindtap="goDetail" data-id="{{item.id}}">
        <van-card thumb="{{item.cover}}" title="{{item.title}}" desc="{{item.locationDisplay}}">
          <view slot="tags" class="card-time">{{item.startDisplay}}</view>
        </van-card>
      </view>
    </block>

    <van-empty wx:if="{{!loading && recommendList.length === 0}}" image="search" description="{{i18n.emptyRecommend}}" />
  </view>
</scroll-view>

<van-tabbar active="{{bottomActive}}" bind:change="onBottomTabChange" safe-area-inset-bottom>
  <van-tabbar-item name="home" icon="home-o">首页</van-tabbar-item>
  <van-tabbar-item name="find" icon="search">找活动</van-tabbar-item>
  <van-tabbar-item name="mine" icon="contact">我的</van-tabbar-item>
</van-tabbar>

<van-toast id="van-toast" />
<van-notify id="van-notify" />
