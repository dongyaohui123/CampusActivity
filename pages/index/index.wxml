<navigation-bar title="{{i18n.navTitle}}" back="{{false}}" color="#111111" background="#f7f8fa"></navigation-bar>

<scroll-view class="home-scroll" scroll-y type="list">
  <view class="page-body with-bottom-nav">
    <view class="card banner-card">
      <swiper indicator-dots autoplay interval="3000" circular>
        <block wx:for="{{banners}}" wx:key="*this">
          <swiper-item>
            <image class="banner-image" src="{{item}}" mode="aspectFill" />
          </swiper-item>
        </block>
      </swiper>
    </view>

    <view class="card quick-card">
      <view class="quick-item" data-action="myActivity" bindtap="onQuickTap">
        <view class="quick-icon orange">*</view>
        <text class="quick-text">{{i18n.myActivity}}</text>
      </view>
      <view class="quick-item" data-action="myOrg" bindtap="onQuickTap">
        <view class="quick-icon blue">#</view>
        <text class="quick-text">{{i18n.myOrg}}</text>
      </view>
      <view class="quick-item" data-action="publish" bindtap="onQuickTap">
        <view class="quick-icon cyan">></view>
        <text class="quick-text">{{i18n.publish}}</text>
      </view>
    </view>

    <view class="section-title row-between">
      <text>{{i18n.recommend}}</text>
    </view>

    <view wx:if="{{loading}}" class="empty">{{i18n.loading}}</view>

    <block wx:for="{{recommendList}}" wx:key="id">
      <view class="card activity-row" bindtap="goDetail" data-id="{{item.id}}">
        <image class="cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="activity-main">
          <view class="name">{{item.title}}</view>
          <view class="meta">{{item.locationDisplay}}</view>
          <view class="meta">{{item.startDisplay}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && recommendList.length === 0}}" class="empty">{{i18n.emptyRecommend}}</view>
  </view>
</scroll-view>

<bottom-nav active="home" bind:change="onBottomTabChange"></bottom-nav>