page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fb 220rpx, #f5f7fb 100%);
}

.home-scroll {
  flex: 1;
}

.banner-card {
  padding: 0;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #dfe7f1;
  position: relative;
}

swiper {
  height: 336rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 56rpx 24rpx 22rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(17, 24, 39, 0.64) 100%);
}

.banner-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: block;
}

.banner-sub {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #e6edf8;
  padding: 18rpx 8rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 32%;
  padding: 8rpx 0;
  border-radius: 14rpx;
}

.quick-item:active {
  background: #f3f6ff;
}

.quick-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.quick-icon.orange {
  background: linear-gradient(135deg, #ff9f68, #ff7f5f);
}

.quick-icon.blue {
  background: linear-gradient(135deg, #5f88ff, #3f6ef6);
}

.quick-icon.cyan {
  background: linear-gradient(135deg, #35b7cf, #2997ff);
}

.quick-text {
  color: #445069;
  font-size: 24rpx;
  font-weight: 600;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 6rpx 18rpx;
  color: #1f2937;
}

.activity-row {
  display: flex;
  border: 1rpx solid #e6edf8;
  border-radius: 18rpx;
  overflow: hidden;
}

.cover {
  width: 208rpx;
  height: 152rpx;
  border-radius: 0;
  margin-right: 18rpx;
  background: #edf2f7;
}

.activity-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.name {
  font-size: 29rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
  margin-top: 2rpx;
}

.meta {
  color: #667085;
  font-size: 24rpx;
}
