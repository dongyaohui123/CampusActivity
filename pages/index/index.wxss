page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.home-scroll {
  flex: 1;
}

.banner-card {
  padding: 0;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #eceef2;
}

swiper {
  height: 336rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 56rpx 24rpx 22rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(17, 24, 39, 0.64) 100%);
}

.banner-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: block;
}

.banner-sub {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.quick-card {
  padding: 6rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 6rpx 18rpx;
  color: #1f2937;
}

.activity-card-wrap {
  padding: 0;
}

.card-time {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}
