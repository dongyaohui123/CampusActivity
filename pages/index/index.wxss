page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.home-scroll {
  flex: 1;
}

.banner-card {
  padding: 0;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid #eef1f4;
}

swiper {
  height: 320rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.quick-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid #edf1f6;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.quick-icon.orange {
  background: #ff9f68;
}

.quick-icon.blue {
  background: #5f88ff;
}

.quick-icon.cyan {
  background: #35b7cf;
}

.quick-text {
  color: #4b5563;
  font-size: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 8rpx 4rpx 16rpx;
  color: #111827;
}

.activity-row {
  display: flex;
  border: 1rpx solid #edf1f6;
}

.cover {
  width: 184rpx;
  height: 144rpx;
  border-radius: 12rpx;
  margin-right: 18rpx;
  background: #edf2f7;
}

.activity-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
}

.meta {
  color: #6b7280;
  font-size: 24rpx;
}

