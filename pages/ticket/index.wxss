page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f4f7fb;
}

.ticket-scroll {
  flex: 1;
  min-height: 0;
}

.ticket-hero {
  margin: 20rpx 0 16rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #1f5eff, #4c8dff);
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(47, 108, 243, 0.24);
}

.ticket-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 700;
}

.ticket-status.is-used {
  background: rgba(15, 23, 42, 0.2);
}

.ticket-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ticket-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.ticket-card,
.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #e3e8f0;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.07);
}

.ticket-card {
  padding: 28rpx 24rpx;
  text-align: center;
}

.ticket-qr {
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
  display: block;
}

.ticket-code {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 2rpx;
}

.ticket-hint {
  margin: 14rpx 0 22rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.info-card {
  margin: 16rpx 0 24rpx;
  padding: 10rpx 22rpx;
}

.info-row {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  width: 132rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 700;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #1f2937;
  line-height: 1.7;
}
