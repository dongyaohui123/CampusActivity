.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: modalFadeIn 0.3s ease-out;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 图标 */
.modal-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
}

.modal-icon.icon-success {
  background: linear-gradient(135deg, #5062f6 0%, #647cff 100%);
}

.modal-icon.icon-error {
  background: linear-gradient(135deg, #5062f6 0%, #647cff 100%);
}

.modal-icon.icon-warning {
  background: linear-gradient(135deg, #5062f6 0%, #647cff 100%);
}

.modal-icon.icon-info {
  background: linear-gradient(135deg, #5062f6 0%, #647cff 100%);
}

/* 标题 */
.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  text-align: center;
}

/* 消息 */
.modal-message {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 48rpx;
  word-break: break-all;
}

/* 确认按钮 */
.modal-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #5062f6 0%, #647cff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 88rpx;
  padding: 0;
}

.modal-btn::after {
  border: none;
}
