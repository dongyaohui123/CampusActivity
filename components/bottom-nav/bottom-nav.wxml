<view class="bottom-nav-wrap">
  <view class="bottom-nav">
    <view class="tab {{active === 'home' ? 'tab-active' : ''}}" data-tab="home" bindtap="onTabTap">
      <text class="tab-icon">{{icons.home}}</text>
      <text class="tab-label">{{labels.home}}</text>
    </view>
    <view class="tab {{active === 'find' ? 'tab-active' : ''}}" data-tab="find" bindtap="onTabTap">
      <text class="tab-icon">{{icons.find}}</text>
      <text class="tab-label">{{labels.find}}</text>
    </view>
    <view class="tab {{active === 'mine' ? 'tab-active' : ''}}" data-tab="mine" bindtap="onTabTap">
      <text class="tab-icon">{{icons.mine}}</text>
      <text class="tab-label">{{labels.mine}}</text>
    </view>
  </view>
</view>
