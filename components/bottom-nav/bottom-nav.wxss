.bottom-nav-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 0 16rpx 12rpx;
  box-sizing: border-box;
  background: transparent;
}

.bottom-nav {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 8rpx 8rpx calc(env(safe-area-inset-bottom) + 8rpx);
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7edf4;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.1);
  backdrop-filter: blur(10rpx);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a94a6;
  border-radius: 16rpx;
  min-height: 80rpx;
  transition: all 0.2s ease;
}

.tab-active {
  color: #2f6cf3;
  background: #edf3ff;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: rgba(47, 108, 243, 0.08);
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.tab-label {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1;
  font-weight: 600;
}
