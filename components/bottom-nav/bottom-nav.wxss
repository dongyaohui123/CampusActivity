.bottom-nav-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.bottom-nav {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 10rpx 0 calc(env(safe-area-inset-bottom) + 10rpx);
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7280;
}

.tab-active {
  color: #2f80ed;
}

.tab-icon {
  font-size: 32rpx;
  line-height: 1;
}

.tab-label {
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1;
}
