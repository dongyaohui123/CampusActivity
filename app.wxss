/** app.wxss **/
page {
  min-height: 100%;
  background: #f7f8fa;
  color: #222;
  font-size: 28rpx;
}

.page-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.with-bottom-nav {
  padding-bottom: 132rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #edf1f6;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.muted {
  color: #667085;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-12 {
  gap: 12rpx;
}

.mb-12 {
  margin-bottom: 12rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: #98a2b3;
}

