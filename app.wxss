/** app.wxss **/
@import "/static/css/icon.wxss";

page {
  --bg-main: #f4f7fb;
  --bg-card: #ffffff;
  --text-primary: #1f2937;
  --text-secondary: #667085;
  --brand: #2f6cf3;
  --brand-soft: #edf3ff;
  --line-soft: #e8edf3;
  min-height: 100%;
  background: var(--bg-main);
  color: var(--text-primary);
  font-size: 28rpx;
}

/* Toast 样式覆盖 - 品牌色统一 */
.van-toast {
  background-color: #5062f6 !important;
  color: #ffffff !important;
  border-radius: 14px !important;
}

/* Notify 样式覆盖 - 品牌色统一 */
.van-notify {
  background-color: #5062f6 !important;
  color: #ffffff !important;
}

.van-notify--danger {
  background-color: #5062f6 !important;
}

.page-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.muted {
  color: var(--text-secondary);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-12 {
  gap: 12rpx;
}

.mb-12 {
  margin-bottom: 12rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: #98a2b3;
}

